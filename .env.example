# Example environment configuration for TFT AI Player
# Copy this file to .env and insert your real keys:
#   cp .env.example .env

# Optional Riot Games API Key (from https://developer.riotgames.com/)
# Used by the collector daemon to replenish low-elo player queues directly from official League endpoints
RIOT_API_KEY=your_riot_api_key_here

# Optional proxy for web scraping (HTTP or SOCKS5)
# ALL_PROXY=socks5://127.0.0.1:9050

# Optional Tor ControlPort to rotate IP on HTTP 429
# TOR_CONTROL_PORT=9051

# Optional Telegram Bot for live notifications and status commands (/status, /recent, /link)
# Create a bot in 30s with @BotFather on Telegram:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Optional: restrict bot access to your Telegram user/chat ID (find with @userinfobot):
# TELEGRAM_CHAT_ID=123456789
