[Unit]
Description=TFT AI Dataset Web Dashboard and Telegram Monitor
After=network-online.target tft-collector.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=javi
Group=javi
WorkingDirectory=/home/javi/tft-ai-player

EnvironmentFile=-/home/javi/tft-ai-player/.env
Environment=PYTHONPATH=/home/javi/tft-ai-player/src
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/javi/tft-venv/bin/python -m tft_ai_player monitor \
    --host 0.0.0.0 \
    --port 8080 \
    --output-dir /home/javi/tft-ai-player/data \
    --db-path /home/javi/tft-ai-player/data/collector.db \
    --status-file /home/javi/tft-ai-player/data/status.json

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=15

LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tft-monitor

[Install]
WantedBy=multi-user.target
